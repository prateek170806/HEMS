generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String      @id @default(uuid())
  customerId     String      @unique
  name           String
  email          String      @unique
  phone          String?     @unique
  passwordHash   String
  avatarInitials String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  households     Household[]
}

model Household {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  timezone          String            @default("Asia/Kolkata")
  currency          String            @default("INR")
  powerLimitKw      Float             @default(5.5)
  batteryReserve    Float             @default(20)
  optimizationMode  String            @default("economic")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  baseLoad          Float             @default(10)
  evDisconnected    Boolean           @default(false)
  forecastError     Float             @default(0)
  inverterFault     Boolean           @default(false)
  smartMeterOffline Boolean           @default(false)
  solarIrradiance   Float             @default(50)
  simulationStatus  String            @default("LIVE")
  simulationSpeed   Float             @default(1.0)
  simulationTime    DateTime          @default(now())
  simulationLastTick DateTime         @default(now())
  currentBatterySoc Float             @default(20.0)
  appliances        Appliance[]
  meterReadings     MeterReading[]
  notifications     Notification[]
  optimizationRuns  OptimizationRun[]
  schedules         Schedule[]
  tariffs           Tariff[]
}

model Appliance {
  id                String     @id @default(uuid())
  householdId       String
  name              String
  category          String
  ratedPower        Float
  status            String     @default("offline")
  flexibility       String     @default("non_flexible")
  minRuntime        Float      @default(0)
  maxRuntime        Float      @default(24)
  earliestStart     String?
  latestFinish      String?
  priority          String     @default("medium")
  automationEnabled Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  household         Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  schedules         Schedule[]

  @@index([householdId])
}

model Tariff {
  id          String         @id @default(uuid())
  householdId String
  name        String
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  periods     TariffPeriod[]

  @@index([householdId])
}

model TariffPeriod {
  id          String   @id @default(uuid())
  tariffId    String
  name        String
  startTime   String
  endTime     String
  pricePerKwh Float
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tariff      Tariff   @relation(fields: [tariffId], references: [id], onDelete: Cascade)
}

model MeterReading {
  id           String    @id @default(uuid())
  householdId  String
  timestamp    DateTime
  importKw     Float     @default(0)
  exportKw     Float     @default(0)
  solarKw      Float     @default(0)
  batterySoc   Float     @default(0)
  homeDemandKw Float     @default(0)
  createdAt    DateTime  @default(now())
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Notification {
  id          String    @id @default(uuid())
  householdId String
  type        String
  message     String
  isRead      Boolean   @default(false)
  timestamp   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model OptimizationRun {
  id                  String     @id @default(uuid())
  householdId         String
  timestamp           DateTime   @default(now())
  horizonHours        Int
  status              String
  mode                String
  projectedCost       Float?
  projectedPeak       Float?
  savings             Float?
  explanation         String?
  createdAt           DateTime   @default(now())
  baselineCost        Float?
  baselinePeak        Float?
  gridImport          Float?
  ruleBasedCost       Float?
  ruleBasedPeak       Float?
  runtimeMs           Int?
  solarUsage          Float?
  baselineGridImport  Float?
  baselineSolarUsage  Float?
  ruleBasedGridImport Float?
  ruleBasedSolarUsage Float?
  household           Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  schedules           Schedule[]

  @@index([householdId])
}

model Schedule {
  id             String           @id @default(uuid())
  householdId    String
  applianceId    String
  optimizationId String?
  startTime      DateTime
  endTime        DateTime
  status         String           @default("scheduled")
  reason         String?
  estimatedCost  Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  affectedMetric String?
  impact         String?
  originalEnd    DateTime?
  originalStart  DateTime?
  reasonCategory String?
  appliance      Appliance        @relation(fields: [applianceId], references: [id], onDelete: Cascade)
  household      Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  optimization   OptimizationRun? @relation(fields: [optimizationId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model EmailOTP {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model OtpVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}


