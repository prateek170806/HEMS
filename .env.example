# WattWise HEMS — Required Environment Variables

# Database (server-side only — do NOT prefix with NEXT_PUBLIC_)
DATABASE_URL="postgresql://postgres:password@localhost:5432/hems?schema=public"

# NextAuth.js — REQUIRED in production. Generate with: npx auth secret
# Must be a cryptographically random string of at least 32 characters.
# See: https://authjs.dev/getting-started/deployment
AUTH_SECRET="replace-with-a-secure-random-secret"

# Transactional Email Provider (Optional in dev, required in production for real email delivery)
RESEND_API_KEY="re_123456789_abcdef"
EMAIL_FROM="WattWise Auth <onboarding@resend.dev>"

